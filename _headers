# Header keamanan situs (didukung Cloudflare Pages).
# Setara peran helmet pada sistem Albalad/AnsarPro.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://accounts.google.com https://www.googletagmanager.com https://connect.facebook.net https://analytics.tiktok.com; connect-src 'self' https://revagroup-api.salehasrori.workers.dev https://raw.githubusercontent.com https://accounts.google.com https://www.google-analytics.com https://analytics.tiktok.com https://*.facebook.com; frame-src https://accounts.google.com

# Panel admin tidak boleh diindeks mesin pencari
/admin.html
  X-Robots-Tag: noindex, nofollow
